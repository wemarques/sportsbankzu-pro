# ===========================================================
# SportsBankZU Pro — Environment Variables
# ===========================================================
# Copy to .env and fill in real values:
#   cp .env.example .env
# ===========================================================

# --- AI ---
MISTRAL_API_KEY="sua chave aqui"

# --- External APIs ---
API_FOOTBALL_KEY=""              # https://www.api-football.com/
FOOTYSTATS_API_KEY=""            # https://footystats.org/

# --- PostgreSQL (RDS) ---
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- AWS / S3 ---
S3_BUCKET=meu-bucket-sportsbank
DATA_ROOT=/tmp

# --- Frontend (Next.js) ---
# Set PY_BACKEND_URL in frontend/next/.env.local
# Local:  http://localhost:5001
# Prod:   https://<api-gw-id>.execute-api.us-east-1.amazonaws.com

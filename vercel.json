{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "fluid": true,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(top)frontend/next' ':(top)vercel.json' ':(top)package.json'",
  "functions": {
    "app/api/matches/fetch/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/matches/live/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/fixtures/**/*.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/ai/*/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}

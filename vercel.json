{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "fluid": true,
  "ignoreCommand": "if git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null; then git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- ':(top)frontend/next' ':(top)vercel.json' ':(top)package.json'; else exit 1; fi",
  "functions": {
    "app/api/matches/fetch/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/matches/live/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/fixtures/**/*.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/ai/*/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}

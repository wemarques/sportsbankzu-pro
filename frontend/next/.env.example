# ===========================================================
# SportsBankZU Pro — Next.js Dashboard Environment Variables
# ===========================================================
# Copie este arquivo para .env.local e ajuste os valores:
#   cp .env.example .env.local
# ===========================================================

# URL do backend FastAPI (Python)
# Em desenvolvimento local: http://localhost:5001
# Em produção (AWS Lambda): https://seu-endpoint.execute-api.region.amazonaws.com
# Se não definida, o dashboard usará mock data como fallback.
PY_BACKEND_URL=http://localhost:5001

# Variante pública (client-side fetches, opcional)
# Descomente se precisar fazer fetch direto do browser para o backend
# NEXT_PUBLIC_PY_BACKEND_URL=http://localhost:5001
